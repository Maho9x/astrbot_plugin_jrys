{
    "command": {
        "description": "触发指令名",
        "type": "string",
        "hint": "默认 jrys；同时也支持「今日运势」「运势」两个别名。",
        "default": "jrys"
    },
    "Checkin_HintText": {
        "description": "渲染中提示语",
        "type": "string",
        "hint": "发送指令后先回一句提示，再发图片。填 unset 表示不返回提示语。",
        "default": "unset"
    },
    "daily_draw_limit": {
        "description": "每日运势抽取次数限制",
        "type": "int",
        "hint": "每位用户每天可抽取的次数，超出后只回复提示不再生成图片。填 0 表示不限制。",
        "default": 1
    },
    "font_name": {
        "description": "字体文件",
        "type": "string",
        "hint": "填插件 font/ 目录下的字体文件名，例如 JINGNANBOBOHEI-BOLD-2.TTF。",
        "default": "JINGNANBOBOHEI-BOLD-2.TTF"
    },
    "fortune_weights": {
        "description": "运势抽取权重",
        "type": "object",
        "hint": "键为档位值，值为权重，越大越容易抽到。全部为 0 时使用默认权重。",
        "items": {
            "98": {
                "description": "★★★★★★★ 大吉（98）",
                "type": "int",
                "default": 25,
                "slider": {
                    "min": 0,
                    "max": 100,
                    "step": 1
                }
            },
            "84": {
                "description": "★★★★★★☆ 中吉（84）",
                "type": "int",
                "default": 45,
                "slider": {
                    "min": 0,
                    "max": 100,
                    "step": 1
                }
            },
            "70": {
                "description": "★★★★★☆☆ 吉（70）",
                "type": "int",
                "default": 35,
                "slider": {
                    "min": 0,
                    "max": 100,
                    "step": 1
                }
            },
            "56": {
                "description": "★★★★☆☆☆ 吉带凶（56）",
                "type": "int",
                "default": 30,
                "slider": {
                    "min": 0,
                    "max": 100,
                    "step": 1
                }
            },
            "42": {
                "description": "★★★☆☆☆☆ 吉凶参半（42）",
                "type": "int",
                "default": 15,
                "slider": {
                    "min": 0,
                    "max": 100,
                    "step": 1
                }
            },
            "28": {
                "description": "★★☆☆☆☆☆ 凶带吉（28）",
                "type": "int",
                "default": 12,
                "slider": {
                    "min": 0,
                    "max": 100,
                    "step": 1
                }
            },
            "14": {
                "description": "★☆☆☆☆☆☆ 小凶（14）",
                "type": "int",
                "default": 10,
                "slider": {
                    "min": 0,
                    "max": 100,
                    "step": 1
                }
            },
            "0": {
                "description": "☆☆☆☆☆☆☆ 凶（0）",
                "type": "int",
                "default": 5,
                "slider": {
                    "min": 0,
                    "max": 100,
                    "step": 1
                }
            }
        }
    },
    "HTML_setting": {
        "description": "面板调节（颜色与虚线框）",
        "type": "object",
        "hint": "颜色请填 rgba(r,g,b,a)，例如 rgba(0,0,0,0.5)；也支持 #rrggbb。",
        "items": {
            "MaskColor": {
                "description": "蒙版颜色",
                "type": "string",
                "hint": "底部半透明面板的颜色，格式 rgba(r,g,b,a)，a 为 0-1 的透明度。",
                "default": "rgba(255, 255, 255, 0.66)"
            },
            "Maskblurs": {
                "description": "蒙版模糊半径",
                "type": "int",
                "default": 10,
                "slider": {
                    "min": 0,
                    "max": 100,
                    "step": 1
                }
            },
            "HoroscopeTextColor": {
                "description": "运势文字颜色",
                "type": "string",
                "hint": "「大吉」「中吉」这类总结文字的颜色，格式 rgba(r,g,b,a)。",
                "default": "rgba(68, 66, 73, 1)"
            },
            "luckyStarGradientColor": {
                "description": "运势星星使用彩色渐变",
                "type": "bool",
                "default": true
            },
            "HoroscopeDescriptionTextColor": {
                "description": "运势说明文字颜色",
                "type": "string",
                "hint": "正文与页脚文字的颜色，格式 rgba(r,g,b,a)。",
                "default": "rgba(52, 49, 55, 1)"
            },
            "DashedboxThickn": {
                "description": "虚线框的粗细",
                "type": "int",
                "default": 5,
                "slider": {
                    "min": 0,
                    "max": 20,
                    "step": 1
                }
            },
            "Dashedboxcolor": {
                "description": "虚线框的颜色",
                "type": "string",
                "hint": "格式 rgba(r,g,b,a)。",
                "default": "rgba(255, 255, 255, 0.5)"
            }
        }
    },
    "layout": {
        "description": "布局调节（头像/日期/运势文字/运势星星）",
        "type": "object",
        "hint": "位置偏移为相对默认版式的像素增量，可填负数。头像选择靠左/靠右时，面板会自动变矮，头像与文字块垂直居中对齐。",
        "items": {
            "avatar_show": {
                "description": "显示头像",
                "type": "bool",
                "default": true
            },
            "avatar_position": {
                "description": "头像位置",
                "type": "string",
                "default": "top",
                "options": [
                    "top",
                    "left",
                    "right"
                ],
                "labels": [
                    "靠上（居中）",
                    "靠左",
                    "靠右"
                ]
            },
            "avatar_size": {
                "description": "头像尺寸（像素）",
                "type": "int",
                "default": 74,
                "slider": {
                    "min": 32,
                    "max": 240,
                    "step": 1
                }
            },
            "avatar_offset_x": {
                "description": "头像水平偏移",
                "type": "int",
                "default": 0,
                "slider": {
                    "min": -400,
                    "max": 400,
                    "step": 1
                }
            },
            "avatar_offset_y": {
                "description": "头像垂直偏移",
                "type": "int",
                "default": 0,
                "slider": {
                    "min": -400,
                    "max": 400,
                    "step": 1
                }
            },
            "date_size": {
                "description": "日期字号",
                "type": "int",
                "default": 22,
                "slider": {
                    "min": 8,
                    "max": 80,
                    "step": 1
                }
            },
            "date_offset_x": {
                "description": "日期水平偏移",
                "type": "int",
                "default": 0,
                "slider": {
                    "min": -400,
                    "max": 400,
                    "step": 1
                }
            },
            "date_offset_y": {
                "description": "日期垂直偏移",
                "type": "int",
                "default": 0,
                "slider": {
                    "min": -200,
                    "max": 200,
                    "step": 1
                }
            },
            "summary_size": {
                "description": "运势文字字号",
                "type": "int",
                "default": 38,
                "slider": {
                    "min": 8,
                    "max": 120,
                    "step": 1
                }
            },
            "summary_offset_x": {
                "description": "运势文字水平偏移",
                "type": "int",
                "default": 0,
                "slider": {
                    "min": -400,
                    "max": 400,
                    "step": 1
                }
            },
            "summary_offset_y": {
                "description": "运势文字垂直偏移",
                "type": "int",
                "default": 0,
                "slider": {
                    "min": -200,
                    "max": 200,
                    "step": 1
                }
            },
            "star_size": {
                "description": "运势星星字号",
                "type": "int",
                "default": 34,
                "slider": {
                    "min": 8,
                    "max": 100,
                    "step": 1
                }
            },
            "star_offset_x": {
                "description": "运势星星水平偏移",
                "type": "int",
                "default": 0,
                "slider": {
                    "min": -400,
                    "max": 400,
                    "step": 1
                }
            },
            "star_offset_y": {
                "description": "运势星星垂直偏移",
                "type": "int",
                "default": 0,
                "slider": {
                    "min": -200,
                    "max": 200,
                    "step": 1
                }
            }
        }
    },
    "jrys_keyword_enabled": {
        "description": "启用关键词触发",
        "type": "bool",
        "hint": "开启后，直接发送「今日运势」「运势」「jrys」等关键词即可触发（不需要加 / 前缀）。关闭则只有指令形式生效。",
        "default": true
    },
    "at_sender": {
        "description": "回复时 @ 发送者",
        "type": "bool",
        "hint": "开启后，在群聊里发运势图时会同时 @ 触发指令的群友（私聊不受影响）。",
        "default": true
    },
    "qq_official_optimize": {
        "description": "对 QQ 官方 bot 优化",
        "type": "bool",
        "hint": "QQ 官方机器人 API 不支持把「@群员 + 图片 + 文字」放在同一条消息里，开启后会把 @群员 与图文拆成两条发送：先用 markdown 消息单独 @ 对方（这样 QQ 才会渲染成真正的 @），再发运势图片。\n仅在 QQ 官方机器人平台生效，其他平台不受影响；关闭则维持原来的单条消息。",
        "default": false
    },
    "avatar_cache_expiration": {
        "description": "头像缓存过期时间（秒）",
        "type": "int",
        "hint": "默认 86400 秒（24 小时）。",
        "default": 86400
    }
}
